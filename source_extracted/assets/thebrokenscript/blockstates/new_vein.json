{
    "multipart": [
        {
            "apply": {
                "model": "thebrokenscript:block/vein/vein_center"
            },
            "when": {
                "down": "true"
            }
        },
        {
            "apply": {
                "model": "thebrokenscript:block/vein/vein_center",
                "x": 180
            },
            "when": {
                "up": "true"
            }
        },
        {
            "apply": {
                "model": "thebrokenscript:block/vein/vein_limb"
            },
            "when": {
                "OR": [
                    {"north": "true","down": "true"},
                    {"north_wall": "true","down": "true"}
                ]
            }
        },
        {
            "apply": {
                "model": "thebrokenscript:block/vein/vein_limb",
                "y": 180
            },
            "when": {
                "OR": [
                    {"south": "true","down": "true"},
                    {"south_wall": "true","down": "true"}
