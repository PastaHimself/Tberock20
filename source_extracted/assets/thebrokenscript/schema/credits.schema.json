{
    "$id": "tbs-credits",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "title_": {
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string",
                    "enum": [
                        "title"
                    ]
                },
                "content": {
                    "type": "string"
                }
            },
            "required": [
                "@type",
                "content"
            ]
        },
        "subtitle": {
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string",
                    "enum": [
                        "subtitle"
                    ]
                },
                "content": {
                    "type": "string"
                }
            },
            "required": [
                "@type",
                "content"
            ]
        },
        "section": {
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string",
                    "enum": [
                        "section"
                    ]
                },
                "content": {
                    "type": "string"
                }
            },
            "required": [
                "@type",
                "content"
            ]
        },
        "header": {
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string",
                    "enum": [
                        "header"
                    ]
                },
                "content": {
                    "type": "string"
                }
            },
            "required": [
                "@type",
                "content"
            ]
        },
        "text": {
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string",
                    "enum": [
                        "text"
                    ]
                },
                "content": {
                    "type": "string"
                }
            },
            "required": [
                "@type",
                "content"
            ]
        },
        "lines": {
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string",
                    "enum": [
                        "lines"
                    ]
                },
                "content": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "@type",
                "content"
            ]
        },
        "divider": {
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string",
                    "enum": [
                        "divider"
                    ]
                }
            },
            "required": [
                "@type"
            ]
        }
    },
    "properties": {
        "credits": {
            "type": "array",
            "items": {
                "anyOf": [
                    {
                        "type": "object",
                        "$ref": "#/$defs/title_"
                    },
                    {
                        "type": "object",
                        "$ref": "#/$defs/subtitle"
                    },
                    {
                        "type": "object",
                        "$ref": "#/$defs/divider"
                    },
                    {
                        "type": "object",
                        "$ref": "#/$defs/header"
                    },
                    {
                        "type": "object",
                        "$ref": "#/$defs/text"
                    },
                    {
                        "type": "object",
                        "$ref": "#/$defs/lines"
                    },
                    {
                        "type": "object",
                        "$ref": "#/$defs/section"
                    }
                ]
            }
        }
    },
    "type": "object"
}