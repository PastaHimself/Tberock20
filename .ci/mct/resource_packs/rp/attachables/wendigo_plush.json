{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "thebrokenscript:wendigo_plush",
      "item": {
        "thebrokenscript:wendigo_plush": "query.is_owner_identifier_any('minecraft:player') && context.item_slot == 'head'"
      },
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/items/plush/wendigo"
      },
      "geometry": {
        "default": "geometry.tbs_plush_worn_wendigo"
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
